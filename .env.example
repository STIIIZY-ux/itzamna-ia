# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el .env al repositorio.

# Token del bot (lo obtienes de @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=tu_token_aqui

# Tu Telegram user ID (lo obtienes de @userinfobot en Telegram)
TELEGRAM_ALLOWED_USER_ID=tu_user_id_aqui

# Entorno: development | production
ENVIRONMENT=development

# Modo webhook (true) o polling (false). Para local usa polling.
USE_WEBHOOK=false

# URL pública del webhook (solo si USE_WEBHOOK=true)
WEBHOOK_URL=

# Secreto para validar el header X-Telegram-Bot-Api-Secret-Token (solo si USE_WEBHOOK=true)
TELEGRAM_WEBHOOK_SECRET=

# Puerto del servidor web (Cloud Run usa 8080)
PORT=8080

# --- PostgreSQL (async) ---
# URL async de conexión. Usa los valores del servicio postgres de compose.yaml.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/itzamna

# Tamaño del pool de conexiones
DATABASE_POOL_SIZE=5

# Conexiones extra permitidas por encima del pool
DATABASE_MAX_OVERFLOW=10

# Log de sentencias SQL (solo para desarrollo, NO en producción)
DATABASE_ECHO=false

# --- Google Calendar (OAuth 2.0) ---
# Obtén estos valores en Google Cloud Console (credenciales OAuth "Web/Desktop").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir exactamente con la configurada en la consola (p. ej. http://localhost)
GOOGLE_REDIRECT_URI=http://localhost

# Clave Fernet para cifrar los refresh tokens en la BD.
# Genera una con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ID del calendario a sincronizar ("primary" es el calendario principal)
GOOGLE_CALENDAR_ID=primary

# Ventana (días) hacia atrás/adelante de eventos a sincronizar
GOOGLE_SYNC_TIME_WINDOW_DAYS=120

# Zona horaria del usuario (IANA)
USER_TIMEZONE=America/Tijuana

# --- Planner / Scheduler / Accountability ---
# Modo por defecto: tryhard | guerra | silencio
ACCOUNTABILITY_MODE=tryhard

# Horario activo (hora local, 24h) en el que se permiten notificaciones
ACCOUNTABILITY_ACTIVE_HOUR_START=9
ACCOUNTABILITY_ACTIVE_HOUR_END=21

# Límites para evitar spam
ACCOUNTABILITY_MAX_REMINDERS_PER_DAY=5
ACCOUNTABILITY_TRYHARD_INTERVAL_MINUTES=120
ACCOUNTABILITY_GUERRA_INTERVAL_MINUTES=30

# Scheduler persistente
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_SECONDS=30
SCHEDULER_STALE_CLAIM_SECONDS=300
SCHEDULER_CLAIM_BATCH_SIZE=20

# --- Archivos / Evidencia ---
# Directorio local donde se almacenan los archivos subidos (privado).
STORAGE_DIR=./data/files
# Tamaño máximo por archivo (bytes). 20 MB por defecto.
STORAGE_MAX_FILE_BYTES=20971520
# Máximo de evidencias por tarea.
STORAGE_MAX_EVIDENCE_PER_TASK=10

# --- IA (opcional; desactivada si AI_ENABLED=false o falta AI_API_KEY) ---
AI_ENABLED=false
AI_API_KEY=
AI_PROVIDER=openai-compatible
# Endpoint base (Gemini OpenAI-compatible por defecto)
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_TOKENS=1024
AI_MAX_CALLS_PER_HOUR=200
# TTL de caché de respuestas de IA (segundos). 0 desactiva.
AI_CACHE_TTL_SECONDS=3600

# Alias de Gemini (equivalentes a AI_API_KEY / AI_MODEL)
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Producción / despliegue ---
# Exponer /docs /redoc /openapi.json (false en producción)
DOCS_ENABLED=true
# Días de retención de archivos/evidencia (política documentada)
STORAGE_RETENTION_DAYS=180
